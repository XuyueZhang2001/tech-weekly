{
  "_comment": "科技周报配置。改完这个文件即可换领域、换信源、换收件人。secrets 字段留空则从环境变量读取（GitHub Actions 用 Secrets，本地用 .env 或系统环境变量）。",
  "report": {
    "title": "科技周报",
    "window_days": 10,
    "max_per_domain": 6,
    "max_total": 33,
    "language": "zh",
    "intro": "本期由自动化脚本按公开信源抓取生成，按领域分组、按热度与来源权重排序。",
    "footer": "本邮件由 tech-weekly 自动生成 · 如需退订请直接删除 GitHub 仓库里的定时任务",
    "_note": "max_total 目前只做展示；实际条数 = 各领域 max_items 之和（33）"
  },
  "smtp": {
    "host": "smtp.163.com",
    "port": 465,
    "ssl": true,
    "starttls": false,
    "user": "",
    "password": "",
    "from_name": "科技周报",
    "sender": "",
    "recipients": [],
    "cc": []
  },
  "fetch": {
    "_comment": "retries 只对超时/5xx/429 生效，403·404 不重试。snapshot_fallback 让挂掉的源用上期内容补位；disable_after_failures 连续失败多少期后暂停抓取，cooldown_days 是暂停时长。单个信源可用 user_agent / referer / timeout_seconds / retries 覆盖这里的全局值。",
    "timeout_seconds": 25,
    "workers": 10,
    "retries": 2,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "snapshot_fallback": true,
    "snapshot_per_source": 40,
    "disable_after_failures": 4,
    "cooldown_days": 21,
    "hn_min_points": 10,
    "arxiv_max_results": 8
  },
  "curation": {
    "_comment": "选稿：让大模型判断「值不值得看」。enabled=false 则只用规则打分。threshold 是 0-10 的相关度阈值；pool_per_domain 是每领域送审条数；budget_cny 是本环节花费上限，超了自动退回规则分。",
    "enabled": true,
    "score_threshold": 6.0,
    "pool_per_domain": 14,
    "min_keep_per_domain": 4,
    "topic_dedup": true,
    "batch_size": 20,
    "max_dedup_items": 40,
    "budget_cny": 0.1
  },
  "llm": {
    "_comment": "中文摘要。api_key 留空则读环境变量 LLM_API_KEY（GitHub Actions 用 Secrets）。换服务商只需改 base_url 和 model。",
    "enabled": true,
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com",
    "api_key": "",
    "model": "deepseek-flash",
    "thinking": "disabled",
    "batch_size": 10,
    "timeout_seconds": 120,
    "max_retries": 3,
    "temperature": 0.2,
    "max_tokens": 4096,
    "use_cache": true,
    "price_in_per_m": 2.0,
    "price_out_per_m": 8.0,
    "currency": "CNY"
  },
